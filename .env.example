# Copy file này thành `.env` ở root (cùng cấp pnpm-workspace.yaml)
# rồi điền giá trị thật. File `.env` đã được .gitignore.

# === Database (Supabase) ===
# Lấy ở Supabase Dashboard → Project Settings → Database → Connection string
# Khuyến nghị: chọn "Session pooler" (port 5432, hỗ trợ IPv4 free, prepared statements OK)
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# === Auth ===
# Pepper cho sha256(password + SESSION_SECRET). Tối thiểu 32 ký tự ngẫu nhiên.
# Sinh nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-random-32-plus-character-string

# === API server (Express, artifacts/api-server) ===
# Port API server lắng nghe. Default 8080 nếu không set.
API_PORT=8080

# === Frontend dev server (Vite, artifacts/2grils-ppt) ===
# Port Vite dev server. Phải khác API_PORT.
PORT=5173
# Base URL của frontend (giữ "/" cho dev local)
BASE_PATH=/

# === SePay payment gateway ===
# Lấy ở my.sepay.vn → Profile → API Keys
SEPAY_MERCHANT_ID=SP-LIVE-XXXXXXXX
SEPAY_API_KEY=spsk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bank account dùng để nhận tiền (SePay reconcile theo account này)
# Bank code: VCB MB TCB ACB BIDV TPB VPB STB OCB ...
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# === SePay polling (tu dong fetch giao dich qua User API) ===
# QUAN TRONG: SEPAY_USER_API_TOKEN la token KHAC voi SEPAY_API_KEY o tren!
#   - SEPAY_API_KEY: dung de xac minh webhook tu SePay den (header "Apikey ...")
#   - SEPAY_USER_API_TOKEN: dung de GOI User API tra cuu giao dich (header "Bearer ...")
# Tao token tai: https://my.sepay.vn/access_tokens
# Server se tu poll moi 30 giay → khong can webhook public URL → phu hop local dev.
# Webhook van hoat dong song song (neu co); idempotency theo sepay_transaction_id.
SEPAY_USER_API_TOKEN=
SEPAY_POLL_INTERVAL_MS=30000
SEPAY_POLL_LIMIT=20

# === Public base URL ===
# Production deploy URL hoac ngrok tunnel URL (vi du https://abc.ngrok.app)
# Dung de hien thi webhook URL chinh xac khi setup SePay dashboard
PUBLIC_BASE_URL=http://localhost:8080

# === Production hardening ===
# CORS allowlist — danh sach origin duoc phep, cach nhau bang dau phay.
# De trong (dev) thi cho phep moi origin. Production: bat buoc set.
# Vi du: CORS_ORIGINS=https://2grils.com,https://www.2grils.com
CORS_ORIGINS=

# Trust X-Forwarded-For from reverse proxy (1 = trust 1 proxy hop).
# 0 = khong trust, neu chay direct khong qua proxy.
TRUST_PROXY=1

# Rate limit: so lan dang nhap toi da / 15 phut / IP
RATE_LIMIT_LOGIN_PER_15MIN=10
# So lan reset password toi da / 1 gio / IP
RATE_LIMIT_RESET_PER_HOUR=5

# === LibreOffice (template archive upload) ===
# Path tuyet doi den soffice.exe / soffice. Auto-detect cac duong dan thong dung
# neu khong set. Vi du Windows: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=

# === SMTP (tuy chon — de trong SMTP_HOST neu chua co email service) ===
# Vi du Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false (STARTTLS)
# Vi du SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="2Grils.PPT <no-reply@2grils.com>"

# === Optional ===
# LOG_LEVEL=info
# NODE_ENV=production    # chi set o moi truong production
